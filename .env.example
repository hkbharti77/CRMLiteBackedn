# Hybrid Graph RAG — catalog-driven Excel → Neo4j
# VECTOR = pgvector only (safe default)
# HYBRID = pgvector + Neo4j (use for Excel KnowledgeCatalog routing)
# GRAPH  = Neo4j only
# After setting HYBRID, re-upload existing Excels once so KnowledgeCatalog is populated.
RAG_MODE=HYBRID
NEO4J_URI=neo4j+s://YOUR_AURA_HOST
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
RAG_GRAPH_MAX_DEPTH=2
RAG_GRAPH_MAX_NODES=50
RAG_GRAPH_MAX_RELS=100

# WhatsApp WebRTC Calling Configuration
WHATSAPP_CALLING_ENABLED=true
WHATSAPP_CALLING_SIGNALING=GRAPH
WHATSAPP_CALLING_SIP_ENABLED=false
WHATSAPP_CALLING_SRTP_KEY_EXCHANGE=DTLS
CRMLITE_CALLING_MAX_DURATION_SECONDS=600
CRMLITE_CALLING_SDP_TTL_SECONDS=300
CRMLITE_CALLING_MEDIA_PORT_START=50000
CRMLITE_CALLING_MEDIA_PUBLIC_IP=127.0.0.1
CRMLITE_CALLING_SDP_ANSWER_MS=1500
CRMLITE_CALLING_CONNECT_DEADLINE_MS=5000
CRMLITE_CALLING_ICE_MS=4000
CRMLITE_CALLING_DTLS_MS=3000
CRMLITE_CALLING_MEDIA_START_MS=3000
CRMLITE_CALLING_AI_INIT_MS=2000

# WebRTC STUN/TURN Relay (Metered.ca for Local Testing)
CRMLITE_CALLING_TURN_ENABLED=true
CRMLITE_CALLING_TURN_STUN_HOST=stun.relay.metered.ca
CRMLITE_CALLING_TURN_STUN_PORT=80
CRMLITE_CALLING_TURN_RELAY_HOST=global.relay.metered.ca
CRMLITE_CALLING_TURN_RELAY_PORT=443
CRMLITE_CALLING_TURN_USERNAME=0d945f659dd5e13d95309e4e
CRMLITE_CALLING_TURN_CREDENTIAL=VuiYhkqMMzNL279/

