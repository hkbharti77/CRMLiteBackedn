# CRMLite Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env to version control. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

# Local Database URL (override for non-Docker local dev)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chatcrmdb
SPRING_FLYWAY_ENABLED=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a cryptographically random 64-character string.
# Example (Linux/macOS): openssl rand -hex 64
JWT_SECRET=<generate-64-char-random-hex>
JWT_EXPIRATION=86400000

# ── Encryption ────────────────────────────────────────────────────────────────
# AES key used to encrypt WhatsApp access tokens stored in the database.
# MUST be the same value used when the database was first populated.
# Changing this makes existing encrypted records unreadable.
# Minimum 16 characters. Generate with: openssl rand -hex 32
ENCRYPTION_SECRET_KEY=<generate-32-char-random-hex>

# ── WhatsApp / Meta ───────────────────────────────────────────────────────────
# Set this in the Meta Developer Portal under your app's webhook configuration.
WHATSAPP_VERIFY_TOKEN=<your-chosen-verify-token>
# Found in Meta Developer Portal > App Settings > Basic
META_APP_SECRET=<your-meta-app-secret>
META_APP_ID=<your-meta-app-id>

# ── AI Configuration (Switch via AI_PROVIDER) ────────────────────────────────
# Options: openrouter | google | ollama | openai | local
AI_PROVIDER=openrouter

# 1. OpenRouter (stealth/ox-alpha, claude, gpt-4o, llama-3, etc.)
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL_NAME=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. Google Gemini (used when AI_PROVIDER=google or gemini)
# https://ai.google.dev — generate from Google AI Studio
GEMINI_API_KEY=<your-gemini-api-key>

# 3. Ollama / Local OpenAI-compatible (used when AI_PROVIDER=ollama or local)
AI_OPENAI_BASE_URL=http://localhost:11434/v1
AI_OPENAI_API_KEY=ollama
AI_OPENAI_MODEL_NAME=llama3

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-app-password>
ADMIN_EMAIL=<admin@yourdomain.com>
SENDER_EMAIL=no-reply@yourdomain.com
PLATFORM_BRAND_URL=https://yourdomain.com
PLATFORM_BRAND_NAME=YourBrandName

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Cloudinary Media Storage ──────────────────────────────────────────────────
# https://cloudinary.com — found in Dashboard > API Keys
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
STORAGE_TYPE=CLOUDINARY

# ── Razorpay Billing ──────────────────────────────────────────────────────────
# https://dashboard.razorpay.com
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# ── Google OAuth (Calendar + Meet) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
